{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://solo-founder-harness/schemas/agent_message.schema.json",
  "title": "AgentMessageEnvelope",
  "description": "V3 M4a — agent message envelope 계약(로드맵 §5.1). 이 파일은 계약 문서이고 실제 보안 경계는 런타임 validator src/exec/agentMessage.ts다(신규 검증 의존성 0). 두 정의의 핵심 동치(type enum · required · bounds · pattern)는 src/exec/orchestrationKernel.test.ts가 강제한다. 로드맵 §5.1의 전체 10종 type union 중 M4a가 구현한 것은 task_assignment/spawn_request/result/blocker 4종뿐이며 나머지는 schema와 런타임 모두 거부한다(후속 마일스톤에서 확장). Markdown body는 이 envelope와 함께 다니는 별도 문서이며 타입별 필수 heading은 messageBodyHeadings에 계약으로 적어 둔다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "runId",
    "milestoneId",
    "taskId",
    "parentTaskId",
    "sender",
    "recipient",
    "type",
    "createdAt",
    "dependsOn",
    "artifactRefs",
    "supersedes"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "messageId": { "$ref": "#/definitions/slug" },
    "runId": { "$ref": "#/definitions/slug" },
    "milestoneId": { "$ref": "#/definitions/slug" },
    "taskId": { "$ref": "#/definitions/slug" },
    "parentTaskId": { "oneOf": [{ "$ref": "#/definitions/slug" }, { "type": "null" }] },
    "sender": {
      "description": "task_assignment는 'orchestrator', 나머지 3종은 대상 task의 roleId. 방향 계약은 런타임 validator가 state와 대조해 강제한다(§5.3).",
      "$ref": "#/definitions/slug"
    },
    "recipient": { "$ref": "#/definitions/slug" },
    "type": {
      "description": "M4a 구현 범위 4종.",
      "enum": ["task_assignment", "spawn_request", "result", "blocker"]
    },
    "createdAt": { "$ref": "#/definitions/timestamp" },
    "dependsOn": {
      "description": "선행 taskId 또는 messageId. 미상 id는 거부한다.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/slug" }
    },
    "artifactRefs": {
      "description": "검증된 artifact 포인터만. raw 본문은 어떤 레벨에서도 담지 않는다(§3.2).",
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/definitions/artifactPointer" }
    },
    "supersedes": { "oneOf": [{ "$ref": "#/definitions/slug" }, { "type": "null" }] }
  },
  "definitions": {
    "slug": {
      "description": "소문자·숫자로 시작하고 [a-z0-9._-]만 허용, 1..64자.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "timestamp": {
      "description": "UTC ISO-8601, 밀리초 3자리 고정. clock 주입으로 테스트 결정성을 확보한다.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspacePath": {
      "description": "workspace-relative 정규화 경로. absolute path, '..', 빈 segment, backslash는 거부한다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/\\\\][^\\\\]*$",
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "revision", "producerTaskId", "role"],
      "properties": {
        "path": { "$ref": "#/definitions/workspacePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "producerTaskId": { "$ref": "#/definitions/slug" },
        "role": { "enum": ["input", "contract", "output", "evidence", "diff", "test"] }
      }
    },
    "messageBodyHeadings": {
      "description": "타입별 human-readable Markdown body의 필수 h2 heading 계약(로드맵 §5.2). 런타임 validator는 이 heading이 전부 있고, 이 목록 밖의 h2가 없으며, 중복이 없고, body가 16384 바이트 이하일 것을 요구한다. JSON Schema는 Markdown 본문을 검증할 수 없으므로 여기엔 계약만 기록한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBodyBytes", "task_assignment", "spawn_request", "result", "blocker"],
      "properties": {
        "maxBodyBytes": { "const": 16384 },
        "task_assignment": {
          "const": [
            "Objective",
            "Scope / Ownership",
            "Out of Scope / Forbidden",
            "Inputs and Contracts",
            "Dependencies",
            "Definition of Done",
            "Budget and Permission Envelope",
            "Expected Deliverables"
          ]
        },
        "spawn_request": {
          "const": [
            "Why Split Is Needed",
            "Requested Specialty",
            "Child Scope",
            "Required Inputs",
            "Expected Deliverables",
            "Dependency and Budget Impact"
          ]
        },
        "result": {
          "const": [
            "Result Summary",
            "Work Performed",
            "Decisions and Assumptions",
            "Deliverables",
            "Tests and Evidence",
            "Risks / Known Limitations",
            "Unresolved Questions",
            "Recommended Next Action"
          ]
        },
        "blocker": {
          "const": [
            "Blocking Condition",
            "Evidence",
            "Options and Trade-offs",
            "Required Authority",
            "Safe Default While Waiting"
          ]
        }
      }
    }
  }
}
